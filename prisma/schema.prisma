// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sport {
  id              String     @id
  title           String
  description     String     @db.Text
  summary         String     @db.Text
  fullDescription String     @db.Text
  image           String
  sortOrder       Int        @unique
  tags            SportTag[]
  sportObjects    SportObjectSport[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  sports    SportTag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SportTag {
  sportId    String
  tagId      String
  sortOrder  Int
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sportId, tagId])
}

model SportObject {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  image        String            @default("")
  address      String            @db.Text
  description  String            @db.Text
  workingHours String            @db.Text
  features     String            @db.Text
  paidServices PaidService[]
  sports       SportObjectSport[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PaidService {
  id            String      @id @default(cuid())
  sportObjectId String
  name          String
  description   String      @db.Text
  price         Decimal     @db.Decimal(10, 2)
  sortOrder     Int
  sportObject   SportObject @relation(fields: [sportObjectId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([sportObjectId, sortOrder])
}

model SportObjectSport {
  sportId       String
  sportObjectId String
  sortOrder     Int
  sport         Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)
  sportObject   SportObject @relation(fields: [sportObjectId], references: [id], onDelete: Cascade)

  @@id([sportId, sportObjectId])
}

model HomeSection {
  key       String   @id
  kicker    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeTile {
  sortOrder   Int      @id
  title       String
  badge       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
